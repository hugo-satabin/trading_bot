# ── Binance Testnet ──────────────────────────────────────────
# Regenerer sur https://testnet.binance.vision
BINANCE_API_KEY=TY0qYRhFQ6CsBC0LFlPIO62WtthpjVu5wcKpkCBi8Ohb4weYOrGEkg5mbBFcruZ3
BINANCE_API_SECRET=0tSYIfMA7rJeRfiWcYFaFu9YMg0yMsyfzzQq74h5u3mCAA3RwbDcqFdpXQZeWXi0

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_TOKEN=8783173552:AAHXVbC0QfbzO_7DMWFzKKY2VdNSA_OUfbA
TELEGRAM_CHAT_ID=6377453614

# ── Symboles tradés (virgule pour multi-symboles) ────────────
SYMBOLS=SOLUSDT,AVAXUSDT

# ── Capital de départ ────────────────────────────────────────
INITIAL_BALANCE=1000.0

# ── Frais Binance ────────────────────────────────────────────
# 0.00075 = tarif reduit avec BNB (0.075%)
# 0.001   = tarif standard (0.1%)
FEES_PCT=0.00075

# ── Sizing adaptatif (fraction du solde par trade) ───────────
# Signal faible (score=60) -> TRADE_SIZE_MIN
# Signal fort   (score=100) -> TRADE_SIZE_MAX
# Kelly criterion ajuste ces valeurs automatiquement
TRADE_SIZE_MIN=0.05
TRADE_SIZE_MAX=0.08

# ── Positions ────────────────────────────────────────────────
MAX_POSITIONS=6

# ── Ordres limites ───────────────────────────────────────────
# Achat X% sous le prix du marché pour eviter le slippage
LIMIT_OFFSET=0.0
# Annulation de l'ordre si non rempli apres N secondes
LIMIT_EXPIRE_S=300

# ── Gestion du risque ────────────────────────────────────────
TRAILING_DISTANCE=0.020
BUY_THRESHOLD=68
MAX_DRAWDOWN_PCT=0.10

# ── Sortie temporelle ────────────────────────────────────────
# Ferme une position si elle n'a pas atteint TP1 apres X heures
STAGNATION_EXIT_H=4.0

# ── Circuit breaker ──────────────────────────────────────────
# Suspend les achats apres N pertes consecutives pendant H heures
CIRCUIT_BREAKER_N=3
CIRCUIT_BREAKER_H=1.0

# ── Filtres globaux ──────────────────────────────────────────
# Bloquer si BTC EMA21 1h est baissiere
BTC_FILTER=true
# Bloquer si Fear & Greed < 20 | Reduire taille si > 80
FEAR_GREED_FILTER=true
# Sizing dynamique base sur le win rate reel (20 derniers trades)
KELLY_CRITERION=true

# ── Cadence ──────────────────────────────────────────────────
COOLDOWN_SECONDS=300
LOOP_SLEEP=15
POSITIONS_SLEEP=3

# ── Dashboard web ────────────────────────────────────────────
DASHBOARD_PORT=5000
