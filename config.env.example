# Required for Telegram notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Kraken Spot live trading: read funds + create/cancel orders; never enable withdrawals
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
TRADING_DB_PATH=trading_bot_live.db

# Kraken Spot live markets
QUOTE_CURRENCY=EUR
BTC_SYMBOL=BTC/EUR
SYMBOLS=SOL/EUR,AVAX/EUR
# Maximum capital the bot will budget, also capped by Kraken's free EUR balance
INITIAL_BALANCE=1000.0

# Estimate only; actual fills and fees are read from Kraken
FEES_PCT=0.0026

TRADE_SIZE_MIN=0.05
TRADE_SIZE_MAX=0.08
MAX_POSITIONS=6
COOLDOWN_SECONDS=300
TRAILING_DISTANCE=0.020
MAX_DRAWDOWN_PCT=0.10
LOOP_SLEEP=15
POSITIONS_SLEEP=3
LIMIT_OFFSET=0.0
LIMIT_EXPIRE_S=300
STAGNATION_EXIT_H=4.0
CIRCUIT_BREAKER_N=3
CIRCUIT_BREAKER_H=1.0
BTC_FILTER=true
FEAR_GREED_FILTER=true
KELLY_CRITERION=true
DASHBOARD_PORT=5000
BUY_THRESHOLD=68